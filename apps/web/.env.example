# Kakao Map JavaScript API Key
NEXT_PUBLIC_KAKAO_APP_KEY=your_kakao_js_app_key_here

# Supabase Auth browser client. Publishable keys are designed for client-side
# use; authorization still depends on verified user JWTs and tenant/RBAC/RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
