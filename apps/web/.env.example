# Kakao Map JavaScript API Key
NEXT_PUBLIC_KAKAO_APP_KEY=your_kakao_js_app_key_here

# Supabase Auth browser client. Publishable keys are designed for client-side
# use; authorization still depends on verified user JWTs and tenant/RBAC/RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Local/test bootstrap only. Both flags are ignored by production builds and
# must match the FastAPI REALYTICS_ENABLE_LOCAL_AUTH opt-in.
NEXT_PUBLIC_REALYTICS_ENABLE_LOCAL_AUTH=false
REALYTICS_ENABLE_LOCAL_AUTH=false
REALYTICS_ENABLE_LEGACY_OAUTH_SESSIONS=false

# Canonical public origin used for OAuth callback redirects in production.
REALYTICS_WEB_ORIGIN=https://realytics.example.com

# Set true only after the Kakao Biz App account_email consent item completes a
# real hosted Supabase OAuth round trip. Provider enablement alone is not proof.
REALYTICS_KAKAO_OAUTH_SCOPE_VERIFIED=false
