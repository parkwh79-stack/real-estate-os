# Deployment-only Supabase Auth provider configuration.
#
# Copy only the required values to the ignored repository-root `.env`, or
# inject them from the deployment secret manager. The Supabase CLI resolves
# config.toml `env(...)` references from that process environment. Do not run a
# full hosted `supabase config push` until site_url and redirect URL drift has
# been reviewed; use the provider-only Dashboard/Management API update when
# enabling OAuth on an existing hosted project.
#
# OAuth provider secrets must never be exposed through NEXT_PUBLIC_* variables.

# Google OAuth 2.0 Web application client.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=793485527914-ppo42762pvuiilvi3o13qeir8ftli3jv.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Kakao Login REST API client and client secret.
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=
