# PostgreSQL runtime and migration DSNs are separate from the Supabase
# publishable key. Use least privilege for runtime and an owner/deployment role
# only while running migrations.
# Copy the exact direct or session-pooler host/user from Supabase Connect.
# URL-encode passwords and DSN options; never commit either real DSN.
# Migration example (direct IPv6):
# postgresql://postgres:<encoded-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require&options=-csearch_path%3Drealytics%2Cextensions%2Cpublic%2Cpg_temp
# Runtime example (session pooler IPv4; exact host/user varies by project):
# postgresql://realytics_runtime.<project-ref>:<encoded-password>@<pooler-host>:5432/postgres?sslmode=require&options=-csearch_path%3Drealytics%2Cextensions%2Cpg_temp
REALYTICS_DATABASE_URL=
REALYTICS_MIGRATION_DATABASE_URL=
# Hardened API processes must select exactly api,identity and provide both
# dedicated DSNs. The isolated PF worker selects only pf_worker.
REALYTICS_DB_POOL_ROLES=api,identity
REALYTICS_API_DATABASE_URL=
REALYTICS_IDENTITY_DATABASE_URL=
REALYTICS_PF_WORKER_DATABASE_URL=
REALYTICS_DB_REPLICA_COUNT=1
REALYTICS_DB_CONNECTION_BUDGET=20
REALYTICS_DB_POOL_MAX_WAITING=20
REALYTICS_DB_POOL_TIMEOUT_SECONDS=5
REALYTICS_DB_CONNECT_TIMEOUT_SECONDS=5
REALYTICS_DATABASE_SCHEMA=realytics
REALYTICS_POSTGIS_SCHEMA=extensions
REALYTICS_RUNTIME_DATABASE_ROLE=realytics_runtime
REALYTICS_LEGAL_SYNC_DATABASE_ROLE=realytics_legal_sync
# Shared Supabase DB default: false. Enabling this revokes database TEMPORARY
# from PUBLIC (a role-only revoke is ineffective) and can affect other roles.
REALYTICS_REVOKE_PUBLIC_DATABASE_TEMPORARY=false
# Activate these only after migration, grants, and live RLS checks pass.
REALYTICS_STORAGE_BACKEND=
REALYTICS_PARSER_V2_PERSISTENCE=
REDIS_URL=
OPENAI_API_KEY=
VALUEMAP_API_KEY=
VWORLD_API_KEY=
# Optional VWorld API registered domain. Use localhost only when it was
# registered with the VWorld key; never commit the actual key.
VWORLD_DOMAIN=localhost
LAW_OC=
# Legal Intelligence Core: PostgreSQL verified snapshots are always searched
# first. LAW_OC enables the official Law.go.kr direct fallback. MCP URLs are
# optional transports and never become source authority.
REALYTICS_LAW_OC=
REALYTICS_KOREAN_LAW_API_URL=https://www.law.go.kr/DRF/lawSearch.do
# The official adapter is HTTPS-only and rejects redirects/hosts outside this
# allowlist. Add an approved internal proxy host explicitly when one is used.
REALYTICS_KOREAN_LAW_ALLOWED_HOSTS=law.go.kr,www.law.go.kr,open.law.go.kr
REALYTICS_LEGAL_SNAPSHOT_FRESHNESS_DAYS=7
REALYTICS_LEGAL_PROJECT_QUERY_LIMIT=8
# Corpus publisher needs PUBLIC only for explicitly referenced shared objects;
# pg_temp stays last so untrusted temporary objects cannot shadow application
# relations or extension functions.
REALYTICS_LEGAL_SYNC_SEARCH_PATH=realytics,extensions,public,pg_temp
# Dedicated corpus-maintenance role. Never substitute the API runtime DSN or
# place this credential in a browser-visible environment variable.
REALYTICS_LEGAL_SYNC_DATABASE_URL=
REALYTICS_LEGAL_SYNC_MAX_PAGES=10000
# Authoritative legal payloads have no local-disk fallback. The selected
# S3/MinIO bucket must have versioning and Object Lock enabled; the adapter
# verifies both before writing or reconciling objects.
REALYTICS_LEGAL_RAW_OBJECT_STORAGE=
REALYTICS_LEGAL_RAW_BUCKET=
REALYTICS_LEGAL_RAW_PREFIX=realytics
REALYTICS_LEGAL_RAW_LOCK_MODE=COMPLIANCE
REALYTICS_LEGAL_RAW_RETENTION_DAYS=365
REALYTICS_LEGAL_RECONCILIATION_PAGE_SIZE=500
REALYTICS_LEGAL_RECONCILIATION_MAX_PAGES=100
REALYTICS_LEGAL_ORPHAN_GRACE_HOURS=24
REALYTICS_LEGAL_ORPHAN_MANUAL_REVIEW_DAYS=90
REALYTICS_LEGAL_MCP_LOCAL_URL=
REALYTICS_LEGAL_MCP_LOCAL_ALLOWED_HOSTS=
REALYTICS_LEGAL_MCP_REMOTE_URL=
# Remote MCP is fail-closed. Enable only after data-classification, DPA, and
# egress review; project-confidential/legal-privilege queries must stay local.
REALYTICS_LEGAL_REMOTE_MCP_ENABLED=false
MOLEG_DRF_API_KEY=
STORAGE_BUCKET=
JWT_SECRET=
REALYTICS_ENVIRONMENT=
# Local-only identity bootstrap and social OAuth mock callbacks are deny-by-
# default. Set these to true only for an isolated developer/test environment;
# production, prod, and staging ignore the flags and fail closed.
REALYTICS_ENABLE_LOCAL_AUTH=false
REALYTICS_ENABLE_OAUTH_MOCKS=false
REALYTICS_ENABLE_LEGACY_OAUTH_SESSIONS=false

# Supabase Auth / OIDC. The project may use ES256 or RS256 asymmetric signing
# keys; the API verifies the user access token against this JWKS endpoint.
REALYTICS_IDP_MODE=oidc
REALYTICS_IDP_PROVIDER=supabase
REALYTICS_IDP_ISSUER=https://your-project-ref.supabase.co/auth/v1
REALYTICS_IDP_AUDIENCE=authenticated
REALYTICS_IDP_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
REALYTICS_OIDC_JWKS_CACHE_SECONDS=600
# Production/staging authorization is read from normalized principals and
# tenant_memberships by verified issuer+subject. JWT metadata is never tenant
# or role authority. `claims` is a local deterministic-test compatibility mode.
REALYTICS_IDENTITY_MEMBERSHIP_AUTHORITY=postgres
# Compatibility-only local pilot fallback; hardened startup rejects this flag.
REALYTICS_IDP_PERSONAL_TENANT_FALLBACK=false
REALYTICS_IDP_PERSONAL_TENANT_ROLE=analyst
REALYTICS_RBAC_MODE=strict
REALYTICS_TENANT_ISOLATION_MODE=strict
# Hardened high-risk actions require AAL2 and a recent signed auth_time. The
# window must be approved and explicit in staging/production.
REALYTICS_REQUIRE_HIGH_RISK_STEP_UP=true
REALYTICS_STEP_UP_MAX_AGE_SECONDS=900

# Source-document object storage. Production/staging requires S3/MinIO,
# tenant/project prefixes, encryption, Object Lock, and ClamAV scanning.
REALYTICS_OBJECT_STORAGE=s3
REALYTICS_S3_BUCKET=
REALYTICS_S3_PREFIX=realytics
REALYTICS_S3_ENDPOINT_URL=
REALYTICS_S3_REGION=ap-northeast-2
REALYTICS_S3_SERVER_SIDE_ENCRYPTION=aws:kms
REALYTICS_S3_KMS_KEY_ID=
REALYTICS_OBJECT_RETENTION_DAYS=365
REALYTICS_OBJECT_LOCK_MODE=COMPLIANCE
REALYTICS_REQUIRE_TENANT_SCOPED_OBJECTS=true
REALYTICS_MALWARE_SCANNER=clamav
REALYTICS_CLAMAV_HOST=
REALYTICS_CLAMAV_PORT=3310
REALYTICS_CLAMAV_TIMEOUT_SECONDS=15

# --- 국토부 실거래가 (MOLIT RTMS via data.go.kr, free key) ---
# data.go.kr → 활용신청 the RTMS 실거래가 OpenAPIs; paste the DECODING (raw) key.
DATA_GO_KR_API_KEY=
# Built-in VWorld land-use planning lookup uses VWORLD_API_KEY and calls
# https://api.vworld.kr/ned/data/getLandUseAttr directly. The variables below
# are optional overrides for another approved provider/proxy. Supported placeholders:
# {pnu}, {service_key}, {base_year}. The adapter maps only source-returned
# zoning, statutory FAR/BCR, and district-unit-plan fields.
REALYTICS_LAND_USE_API_KEY=
REALYTICS_LAND_USE_URL_TEMPLATE=
REALYTICS_VWORLD_LAND_USE_URL_TEMPLATE=
REALYTICS_LAND_USE_SOURCE_NAME=
# Optional URL templates for the generic connector router. If absent, the
# configured VWorld key is used for the built-in cadastral/jiga lookup.
REALYTICS_CADASTRAL_URL_TEMPLATE=
REALYTICS_OFFICIAL_LAND_PRICE_URL_TEMPLATE=
REALYTICS_LAND_PRICE_TREND_YEAR=
REALYTICS_LAND_PRICE_TREND_MONTH=
REALYTICS_LAND_PRICE_TREND_SCOPE=A
# Optional base year for VWorld getLandCharacteristics. If blank, the
# enrichment request uses the run base year or the current year.
REALYTICS_LAND_CHARACTERISTICS_YEAR=
# Auto-inject live 실거래가 comparables into the classic PF-review orchestration.
# Leave blank/false for offline/CI; set true in a deployment env with a key.
REALYTICS_LIVE_MARKET_COMPARABLES=

# --- Base URLs (used to build OAuth redirect/callback URLs) ---
REALYTICS_API_BASE_URL=http://127.0.0.1:8000
REALYTICS_WEB_BASE_URL=http://localhost:3000

# --- Kakao Login (real OAuth; without these the login falls back to a pilot mock) ---
# Register a Kakao app at https://developers.kakao.com → 내 애플리케이션.
# Activate Kakao Login + OpenID Connect, add the Redirect URI below, and enable
# consent items: openid, profile_nickname, account_email.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:8000/auth/kakao/callback
# KAKAO_LOGIN_SCOPE=openid profile_nickname account_email
# KAKAO_DEFAULT_TENANT_ID=pilot-tenant
# KAKAO_DEFAULT_ROLE=viewer

# --- Google Login (real OAuth; without these the login falls back to a pilot mock) ---
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console →
# APIs & Services → Credentials. Add the Authorized redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/integrations/google/callback
# GOOGLE_LOGIN_SCOPE=openid email profile
# GOOGLE_DEFAULT_TENANT_ID=google-workspace
# GOOGLE_DEFAULT_ROLE=viewer
