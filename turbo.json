{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "MOLIT_API_KEY",
    "LAW_OC_KEY",
    "REALYTICS_API_ORIGIN",
    "REALYTICS_WEB_ORIGIN",
    "REALYTICS_KAKAO_EMAIL_OPTIONAL_VERIFIED",
    "REALYTICS_ENABLE_LOCAL_AUTH",
    "REALYTICS_ENABLE_LEGACY_OAUTH_SESSIONS",
    "REALYTICS_E2E_BASE_URL",
    "REALYTICS_NEXT_DIST_DIR",
    "REALYTICS_LIVE_AUTH_SMOKE",
    "REALYTICS_LIVE_AUTH_STORAGE_STATE",
    "REALYTICS_LIVE_AUTH_PROVIDER",
    "REALYTICS_LIVE_AUTH_REQUIRE_AAL2",
    "REALYTICS_LIVE_AUTH_REVOKE_OTHERS",
    "REALYTICS_LIVE_AUTH_MAKER_CHECKER",
    "REALYTICS_LIVE_AUTH_EXECUTE_FINAL_ACTIONS",
    "REALYTICS_LIVE_AUTH_MAKER_STORAGE_STATE",
    "REALYTICS_LIVE_AUTH_CHECKER_STORAGE_STATE",
    "REALYTICS_LIVE_AUTH_MAKER_PROVIDER",
    "REALYTICS_LIVE_AUTH_CHECKER_PROVIDER",
    "REALYTICS_LIVE_PF_PROJECT_ID",
    "REALYTICS_LIVE_PF_RUN_ID",
    "REALYTICS_LIVE_PF_REPORT_ID",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_REALYTICS_ENABLE_LOCAL_AUTH",
    "NEXT_PUBLIC_KAKAO_APP_KEY",
    "VWORLD_API_KEY",
    "REALYTICS_EXCEL_TEMPLATE_DIR",
    "REALYTICS_EXCEL_TEMPLATE_PATH",
    "REALYTICS_EXCEL_TEMPLATE_ID",
    "REALYTICS_EXCEL_TEMPLATE_VERSION",
    "REALYTICS_SAMPLE_WORKBOOK_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
